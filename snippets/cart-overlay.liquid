<div class="overlay overlay--cart" data-cart aria-hidden="true">
  <aside class="cart-panel" role="dialog" aria-modal="true" aria-labelledby="CartTitle">
    <div class="cart-panel__head">
      <h1 id="CartTitle" class="cart-panel__brand">
        <img
          class="cart-panel__logo"
          src="{{ 'laflarelogo.svg' | asset_url }}"
          alt="{{ 'cart.title' | t }}"
          width="148"
          height="89"
        >
      </h1>
      <button
        type="button"
        class="cart-panel__close"
        data-close-cart
        aria-label="{{ 'general.accessibility.close' | t }}"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M6.4 5.2 5.2 6.4 10.8 12l-5.6 5.6 1.2 1.2L12 13.2l5.6 5.6 1.2-1.2L13.2 12l5.6-5.6-1.2-1.2L12 10.8 6.4 5.2Z"
          />
        </svg>
      </button>
    </div>
    <div class="cart-panel__body">
      <p class="cart-empty" data-cart-empty>{{ 'cart.empty' | t }}</p>
      <div class="cart-lines" data-cart-lines></div>
    </div>
    <div class="cart-panel__foot">
      <div class="cart-total" data-cart-total hidden>
        <span class="cart-total__label">{{ 'cart.total' | t }}</span>
        <span class="cart-total__value" data-cart-total-value></span>
      </div>
      <button type="button" class="atc" data-checkout>{{ 'cart.checkout' | t }}</button>
    </div>
  </aside>
</div>
