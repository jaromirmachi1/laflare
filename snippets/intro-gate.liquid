{%- liquid
  assign intro_count = 30
-%}
<div class="intro" data-intro data-enter-label="{{ 'general.accessibility.enter' | t | escape }}">
  <div class="intro__split">
    <div class="intro__pane">
      <div class="intro__track" data-intro-track="left">
        {%- for pass in (1..2) -%}
          {%- for i in (1..intro_count) -%}
            {%- assign n = i | prepend: '00' | slice: -2, 2 -%}
            {%- assign file = 'intro-' | append: n | append: '.jpg' -%}
            <figure class="intro__shot">
              <img
                src="{{ file | asset_url }}"
                alt=""
                width="1800"
                height="1800"
                {% if forloop.parentloop.first and forloop.first %}fetchpriority="high"{% else %}loading="eager"{% endif %}
                decoding="async"
              >
            </figure>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="intro__pane">
      <div class="intro__track" data-intro-track="right">
        {%- for pass in (1..2) -%}
          {%- for i in (1..intro_count) -%}
            {%- assign n = intro_count | minus: i | plus: 1 | prepend: '00' | slice: -2, 2 -%}
            {%- assign file = 'intro-' | append: n | append: '.jpg' -%}
            <figure class="intro__shot">
              <img
                src="{{ file | asset_url }}"
                alt=""
                width="1800"
                height="1800"
                loading="eager"
                decoding="async"
              >
            </figure>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  <img
    class="intro__logo"
    src="{{ 'laflarelogo.svg' | asset_url }}"
    alt="{{ shop.name }}"
    width="14875"
    height="8892"
  >
</div>
