{% render 'intro-gate' %}

<main id="Main" class="lock-form">
  {%- form 'storefront_password' -%}
    <div class="lock-form__pill" data-lock-pill data-error="{% if form.errors %}true{% else %}false{% endif %}">
      <label class="lock-form__label" for="LockPassword">{{ 'customer.password' | t }}</label>
      <input
        id="LockPassword"
        class="lock-form__input"
        type="password"
        name="password"
        placeholder="{{ section.settings.placeholder | escape }}"
        autocomplete="current-password"
        required
        {% if form.errors %}aria-invalid="true" aria-describedby="LockError"{% endif %}
      >
      <button class="atc" type="submit">{{ 'general.accessibility.enter' | t }}</button>
    </div>
    {%- if form.errors -%}
      <p class="lock-form__error" id="LockError" role="alert">{{ section.settings.error_text }}</p>
    {%- endif -%}
  {%- endform -%}
</main>

<script src="{{ 'lock.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Password" },
    { "type": "text", "id": "error_text", "label": "Wrong password message", "default": "Wrong password" }
  ]
}
{% endschema %}
