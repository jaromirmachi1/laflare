{%- liquid
  assign stage_collection = section.settings.collection
  if request.page_type == 'collection'
    assign stage_collection = collection
  elsif stage_collection == blank
    assign stage_collection = collections.all
  endif
  if request.page_type == 'index'
    assign stage_products = stage_collection.products | sort: 'published_at' | reverse
  else
    assign stage_products = stage_collection.products
  endif
  assign show_view_toggle = false
  if request.page_type == 'index' or request.page_type == 'collection'
    assign show_view_toggle = true
  endif
  assign initial_handle = ''
  assign open_detail = false
  if request.page_type == 'product'
    assign initial_handle = product.handle
    assign open_detail = true
  endif
  if request.page_type == 'collection'
    assign grid_crumb = stage_collection.title
  else
    assign grid_crumb = 'general.accessibility.shop' | t
  endif
-%}

{% if request.page_type == 'index' %}
  {% render 'intro-gate' %}
{% endif %}

{%- if show_view_toggle -%}
  <script>
    try {
      if (localStorage.getItem('laflare-view') === 'grid') document.body.classList.add('is-grid');
    } catch (e) {}
  </script>
{%- endif -%}

<main id="Main" class="stage">
  <p class="stage-loader" role="status">{{ 'general.accessibility.loading' | t }}</p>
  <header class="chrome chrome--top">
    {% render 'logo' %}
    {% render 'chrome-actions', view_toggle: show_view_toggle %}
  </header>

  <section class="coverflow" aria-label="{{ shop.name }}">
    <div class="coverflow__track" data-track>
      {% if stage_collection.products_count == 0 %}
        <p class="empty">{{ 'cart.empty' | t }}</p>
      {% endif %}
      {% for item in stage_products %}
        <button
          type="button"
          class="cover-item{% if forloop.first %} is-current{% endif %}"
          data-item
          data-handle="{{ item.handle }}"
          style="--x: calc({{ forloop.index0 }} * (var(--item) + var(--item-gap)))"
          aria-label="{{ 'general.accessibility.open_product' | t: title: item.title }}"
        >
          {%- liquid
            assign on_sale = false
            if item.compare_at_price > item.price
              assign on_sale = true
            endif
            for tag in item.tags
              assign tag_down = tag | downcase
              if tag_down == 'sale' or tag_down == 'akce'
                assign on_sale = true
              endif
            endfor
          -%}
          {% if item.featured_image %}
            <img
              src="{{ item.featured_image | image_url: width: 800 }}"
              alt="{{ item.featured_image.alt | default: item.title | escape }}"
              width="800"
              height="800"
              {% if forloop.first %}fetchpriority="high"{% else %}loading="eager"{% endif %}
            >
          {% endif %}
          {% if on_sale and item.available %}
            <span class="sale-pill">{{ 'product.sale' | t }}</span>
          {% endif %}
          {% unless item.available %}
            <span class="sold-pill">{{ 'product.sold_out' | t }}</span>
          {% endunless %}
        </button>
      {% endfor %}
    </div>
  </section>

  {%- if show_view_toggle -%}
    <section
      class="grid-view"
      data-grid
      aria-label="{{ shop.name }}"
      data-label-all="{{ 'general.accessibility.filter_all' | t | escape }}"
      data-label-category="{{ 'general.accessibility.filter_category' | t | escape }}"
      data-label-color="{{ 'general.accessibility.filter_color' | t | escape }}"
      data-label-size="{{ 'general.accessibility.filter_size' | t | escape }}"
      data-label-empty="{{ 'general.accessibility.filter_empty' | t | escape }}"
    >
      <nav class="grid-crumbs" aria-label="Breadcrumb">
        <a class="grid-crumbs__link" href="{{ routes.root_url }}">{{ 'general.accessibility.home' | t }}</a>
        <span class="grid-crumbs__sep" aria-hidden="true">/</span>
        <span class="grid-crumbs__current" aria-current="page">{{ grid_crumb }}</span>
      </nav>
      <div class="grid-filters" data-grid-filters hidden></div>
      <ul class="grid-view__list" role="list">
        {%- for item in stage_products -%}
          {%- liquid
            assign filter_type = item.product_type | strip
            if filter_type == blank
              assign title_up = item.title | upcase
              if title_up contains 'HOODIE'
                assign filter_type = 'Hoodies'
              elsif title_up contains 'ZIP'
                assign filter_type = 'Zip'
              elsif title_up contains 'TEE' or title_up contains 'T-SHIRT' or title_up contains 'TRIKO'
                assign filter_type = 'T-Shirts'
              else
                assign filter_type = 'Other'
              endif
            endif
            assign filter_sizes = ''
            assign filter_colors = ''
            for option in item.options_with_values
              assign oname = option.name | downcase
              if oname contains 'size' or oname contains 'velikost'
                for value in option.values
                  if filter_sizes == blank
                    assign filter_sizes = value
                  else
                    assign filter_sizes = filter_sizes | append: '|' | append: value
                  endif
                endfor
              endif
              if oname contains 'color' or oname contains 'colour' or oname contains 'barva'
                for value in option.values
                  if filter_colors == blank
                    assign filter_colors = value
                  else
                    assign filter_colors = filter_colors | append: '|' | append: value
                  endif
                endfor
              endif
            endfor
            assign on_sale = false
            if item.compare_at_price > item.price
              assign on_sale = true
            endif
            for tag in item.tags
              assign tag_down = tag | downcase
              if tag_down == 'sale' or tag_down == 'akce'
                assign on_sale = true
              endif
            endfor
          -%}
          <li
            class="grid-card{% unless item.available %} is-sold{% endunless %}"
            data-grid-card
            data-type="{{ filter_type | escape }}"
            data-sizes="{{ filter_sizes | escape }}"
            data-colors="{{ filter_colors | escape }}"
            data-grid-title="{{ item.title | escape }}"
            data-grid-image="{{ item.featured_image | image_url: width: 400 | escape }}"
          >
            <a class="grid-card__link" href="{{ item.url }}">
              <span class="grid-card__media">
                {%- if item.featured_image -%}
                  <img
                    class="grid-card__img"
                    src="{{ item.featured_image | image_url: width: 900 }}"
                    srcset="{{ item.featured_image | image_url: width: 450 }} 450w, {{ item.featured_image | image_url: width: 900 }} 900w"
                    sizes="(min-width: 1100px) 22vw, (min-width: 768px) 30vw, 48vw"
                    alt="{{ item.featured_image.alt | default: item.title | escape }}"
                    width="900"
                    height="1125"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    decoding="async"
                    {% if forloop.first %}fetchpriority="high"{% endif %}
                  >
                  {%- if item.images.size > 1 -%}
                    <img
                      class="grid-card__img grid-card__img--alt"
                      src="{{ item.images[1] | image_url: width: 900 }}"
                      alt=""
                      width="900"
                      height="1125"
                      loading="lazy"
                      decoding="async"
                    >
                  {%- endif -%}
                {%- endif -%}
                {%- if on_sale and item.available -%}
                  <span class="sale-pill">{{ 'product.sale' | t }}</span>
                {%- endif -%}
                {%- unless item.available -%}
                  <span class="sold-pill">{{ 'product.sold_out' | t }}</span>
                {%- endunless -%}
              </span>
              <span class="grid-card__meta">
                <span class="grid-card__title">{{ item.title }}</span>
                <span class="grid-card__price">{{ item.price | money_without_currency | append: ' CZK' }}</span>
              </span>
            </a>
            {%- if item.available -%}
              <div class="grid-card__quick" role="group" aria-label="{{ 'product.size' | t }}">
                {%- for variant in item.variants -%}
                  <button
                    type="button"
                    class="grid-card__size{% unless variant.available %} is-sold{% endunless %}"
                    data-grid-add
                    data-variant-id="{{ variant.id }}"
                    data-variant-title="{{ variant.title | escape }}"
                    data-variant-price="{{ variant.price | money_without_currency | append: ' CZK' | strip | escape }}"
                    {% unless variant.available %}disabled aria-disabled="true"{% endunless %}
                  >
                    {{ variant.title }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      <p class="grid-view__empty" data-grid-empty hidden>{{ 'general.accessibility.filter_empty' | t }}</p>
    </section>
  {%- endif -%}

  <h2 class="product-title" data-product-title></h2>

  <div class="detail-bar" data-detail>
    <div class="detail-row">
      <div class="field">
        <label for="StageSize">{{ 'product.size' | t }}</label>
        <select id="StageSize" data-size></select>
      </div>
      <div class="price" data-price></div>
    </div>
    <div class="detail-row detail-row--atc">
      <button type="button" class="more-btn" data-more>{{ 'product.more' | t }}</button>
      <button type="button" class="atc" data-atc>{{ 'product.add' | t }}</button>
    </div>
    <div class="product-copy" data-copy></div>
  </div>
</main>

{% render 'info-overlay' %}

<div class="sticky-atc" data-sticky-atc hidden>
  <button
    type="button"
    class="sticky-atc__back"
    data-detail-back
    aria-label="{{ 'general.accessibility.back' | t }}"
  >
    <img
      src="{{ 'back-btn.png' | asset_url }}"
      alt=""
      width="66"
      height="66"
      decoding="async"
    />
  </button>
  <button type="button" class="atc sticky-atc__btn" data-atc-sticky>
    {{ 'product.add' | t }}
  </button>
</div>

<div class="wheel-dock">
  {% render 'ipod-menu' %}
  <div class="wheel-wrap">
    {% render 'click-wheel' %}
  </div>
</div>

{% render 'cart-overlay' %}

{% render 'legals-overlay' %}

{%- if show_view_toggle -%}
  <script src="{{ 'view-toggle.js' | asset_url }}" defer></script>
{%- endif -%}

<script type="application/json" id="StageData">
  {
    "preview": false,
    "shopUrl": {{ routes.root_url | json }},
    "initialHandle": {{ initial_handle | json }},
    "openDetail": {{ open_detail | json }},
    "i18n": {
      "add": {{ 'product.add' | t | json }},
      "sold_out": {{ 'product.sold_out' | t | json }},
      "more": {{ 'product.more' | t | json }},
      "less": {{ 'product.less' | t | json }},
      "remove": {{ 'cart.remove' | t | json }},
      "quantity": {{ 'cart.quantity' | t | json }},
      "qty_up": {{ 'cart.qty_up' | t | json }},
      "qty_down": {{ 'cart.qty_down' | t | json }},
      "preview_checkout": {{ 'cart.preview_checkout' | t | json }},
      "total": {{ 'cart.total' | t | json }},
      "shipping_remain": {{ 'cart.shipping_remain' | t | json }},
      "shipping_unlocked": {{ 'cart.shipping_unlocked' | t | json }},
      "back": {{ 'general.accessibility.back' | t | json }},
      "menu": {{ 'general.accessibility.menu' | t | json }}
    },
    "products": [
      {% for item in stage_products %}
        {
          "id": {{ item.id }},
          "handle": {{ item.handle | json }},
          "title": {{ item.title | json }},
          "url": {{ item.url | json }},
          "available": {{ item.available }},
          "price_formatted": {{ item.price | money_without_currency | append: ' CZK' | strip | json }},
          "description": {{ item.description | strip_html | json }},
          "description_html": {{ item.description | json }},
          "images": [
            {% for image in item.images %}
              {{ image | image_url: width: 1400 | json }}{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          "variants": [
            {% for variant in item.variants %}
              {
                "id": {{ variant.id }},
                "title": {{ variant.title | json }},
                "available": {{ variant.available }},
                "price_formatted": {{ variant.price | money_without_currency | append: ' CZK' | strip | json }}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
</script>

{% if request.page_type == 'product' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ canonical_url | json }},
      "image": {{ product.featured_image | image_url: width: 1200 | json }},
      "description": {{ product.description | strip_html | json }},
      "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
      "offers": {
        "@type": "Offer",
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ product.price | money_without_currency | json }},
        "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
      }
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "Stage",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to use all products. On the homepage, products are sorted newest first by publish date."
    }
  ],
  "presets": [{ "name": "Stage" }]
}
{% endschema %}
