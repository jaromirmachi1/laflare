<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'general.meta.title' | t }}</title>
    <meta name="description" content="{{ 'general.meta.description' | t }}">
    {{ content_for_header }}
    {% render 'fonts' %}
    {{ 'shop.css' | asset_url | stylesheet_tag }}
    {{ 'lock.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password" data-template="password">
    <style>:root { --cursor: url('{{ 'cursor.svg' | asset_url }}') 4 2, auto; --cursor-hover: url('{{ 'cursor.svg' | asset_url }}') 4 2, auto; }</style>
    {{ content_for_layout }}
  </body>
</html>
