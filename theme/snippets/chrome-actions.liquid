{%- liquid
  assign account_url = routes.account_url
  if customer == blank
    assign account_url = routes.account_login_url
  endif
  assign cart_count = cart.item_count | default: 0
-%}
<nav class="chrome-actions" aria-label="{{ 'general.accessibility.account_cart' | t }}">
  <a
    class="chrome-icon chrome-icon--account"
    href="{{ account_url }}"
    aria-label="{{ 'customer.account' | t }}"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M12 2.8c2.2 0 4 1.8 4 4s-1.8 4-4 4-4-1.8-4-4 1.8-4 4-4Zm0 9.2c4.7 0 8.5 2.6 8.5 7.1 0 .7-.5 1.2-1.2 1.2H4.7c-.7 0-1.2-.5-1.2-1.2 0-4.5 3.8-7.1 8.5-7.1Z"
      />
    </svg>
  </a>
  <button
    type="button"
    class="chrome-icon chrome-icon--cart"
    data-open-cart
    aria-label="{{ 'general.accessibility.cart' | t }}"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M8.2 3.2h7.6c.5 0 .9.4.9.9v2.1h2.1c.4 0 .7.4.6.8l-1.5 11.2c-.1.9-.9 1.6-1.8 1.6H7.9c-.9 0-1.7-.7-1.8-1.6L4.6 7c-.1-.4.2-.8.6-.8h2.1V4.1c0-.5.4-.9.9-.9Zm1.4 3h4.8V5.1H9.6v1.1Zm-2.5 2.4.2 1.4h9.4l.2-1.4H7.1Zm.4 3.2.9 6.6h7.2l.9-6.6H7.5Z"
      />
    </svg>
    <span
      class="chrome-icon__count"
      data-cart-count
      {% if cart_count == 0 %}hidden{% endif %}
      >{{ cart_count }}</span
    >
  </button>
</nav>
